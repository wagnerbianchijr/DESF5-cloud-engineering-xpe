# Copy this file to terraform.tfvars and fill in your project ID before running
# terraform plan / terraform apply.

project_id = "your-gcp-project-id"

# Optional overrides
region                       = "us-central1"
name_prefix                  = "desafio-final"
bucket_force_destroy         = true
logs_retention_days          = 365
logs_nearline_after_days     = 30
bigquery_table_expiration_ms = 31536000000
# analyst_principal          = "user:analyst@example.com"
